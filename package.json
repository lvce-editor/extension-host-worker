{
  "name": "@lvce-editor/extension-api-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark:isolated-extension-api": "node packages/build/src/benchmark-isolated-extension-api-size.ts",
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.ts",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.3.0",
    "eslint": "^10.8.1",
    "knip": "^6.23.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3"
  }
}
